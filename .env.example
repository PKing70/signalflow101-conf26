# Copy this file to .env and fill in your workshop credentials.
# .env is gitignored — never commit real credentials.
#
# Your credentials and participant alias are available on the workshop
# credentials page (QR code / URL provided at the start of the session).

SPLUNK_ACCESS_TOKEN=your-access-token-here
SPLUNK_REALM=your-realm-here
PARTICIPANT_ID=participant-your-number

# Take-home Exercise 1 only — add your GitHub username
GITHUB_USERNAME=your-github-username-here
