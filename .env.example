# For Splunk Show SSH/CLI or local Python, copy this file to .env and fill it in.
# For Replit, add the same names and values in Tools > Secrets instead.
# .env is gitignored — never commit real credentials.
#
# The realm, ingest token, and API token are shared workshop values.
# The ingest token must have INGEST authorization scope.
# The API token must have API authorization scope for SignalFlow queries.
# Your participant ID is unique to you.

SPLUNK_REALM=your-realm-here
SPLUNK_INGEST_TOKEN=your-ingest-token-secret-here
SPLUNK_API_TOKEN=your-api-token-secret-here
PARTICIPANT_ID=participant-your-number

# Take-home Exercise 1 only — add your GitHub username
GITHUB_USERNAME=your-github-username-here
